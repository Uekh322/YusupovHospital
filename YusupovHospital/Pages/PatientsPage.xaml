<Page Style="{StaticResource {x:Type Page}}" x:Class="YusupovHospital.PatientsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded">
 <Grid Margin="24,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Пациенты" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Справочники" Click="References_Click" Style="{StaticResource Quiet}"/><Button x:Name="AddButton" Content="+ Добавить пациента" Click="Add_Click"/></StackPanel></Grid>
  <Border Grid.Row="1" Background="White" Padding="14" Margin="0,14,0,0"><StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0"><TextBlock x:Name="SearchLabel" Text="Поиск по ФИО, адресу или номеру"/><TextBox x:Name="SearchBox" TextChanged="Filter_Changed"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="Сортировка"/><ComboBox x:Name="SortBox" SelectionChanged="Filter_Changed"/></StackPanel>
   </Grid>
   <Grid x:Name="MedicalFilters"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Статус лечения"/><ComboBox x:Name="StatusBox" SelectionChanged="Filter_Changed" SelectedIndex="0"><ComboBoxItem Content="Все пациенты"/><ComboBoxItem Content="На лечении"/><ComboBoxItem Content="Лечение завершено"/><ComboBoxItem Content="Без историй болезни"/></ComboBox></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="Вид лечения"/><ComboBox x:Name="TreatmentBox" SelectionChanged="Filter_Changed" SelectedIndex="0" ToolTip="По текущему случаю лечения, а после выздоровления — по последнему"><ComboBoxItem Content="Любой вид лечения"/><ComboBoxItem Content="Амбулаторно"/><ComboBoxItem Content="Стационарно"/></ComboBox></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Отделение"/><ComboBox x:Name="DepartmentBox" SelectionChanged="Filter_Changed" DisplayMemberPath="Name" ToolTip="По текущему случаю лечения, а после выздоровления — по последнему"/></StackPanel>
   </Grid>
  </StackPanel></Border>
  <Grid Grid.Row="2" Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CountText" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Сбросить" Click="Reset_Click" Style="{StaticResource Quiet}"/><Button x:Name="RefreshButton" Content="Обновить" Click="Refresh_Click" Style="{StaticResource Quiet}"/></StackPanel></Grid>
  <Grid Grid.Row="3"><ListView x:Name="PatientsList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"><ListView.ItemTemplate><DataTemplate>
   <Border Padding="16" Background="White" BorderBrush="#E5DFEB" BorderThickness="1" CornerRadius="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image Source="{Binding Photo}" Width="92" Height="110" Stretch="UniformToFill" VerticalAlignment="Top"/>
    <StackPanel Grid.Column="1" Margin="14,0">
     <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="19" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Id, StringFormat=Карточка № {0}}" Foreground="#9364CA" Margin="0,4"/>
     <TextBlock Text="{Binding Details}" TextWrapping="Wrap"/>
     <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding Address, StringFormat=Адрес проживания: {0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding PhoneLine}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding PassportLine}" TextWrapping="Wrap"/><TextBlock Text="{Binding PolicyLine}" TextWrapping="Wrap"/><TextBlock Text="{Binding InnLine}" TextWrapping="Wrap"/><TextBlock Text="{Binding SnilsLine}" TextWrapping="Wrap"/></StackPanel>
      <StackPanel Grid.Column="1" Visibility="{Binding ClinicalVisibility}"><TextBlock Text="{Binding Status}" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding HistoriesLine}" TextWrapping="Wrap" Foreground="#776B86" Margin="0,3"/><TextBlock Text="{Binding DiagnosisLine}" TextWrapping="Wrap"/><TextBlock Text="{Binding DoctorLine}" TextWrapping="Wrap"/><TextBlock Text="{Binding DepartmentLine}" TextWrapping="Wrap"/><TextBlock Text="{Binding TreatmentLine}" TextWrapping="Wrap"/><TextBlock Text="{Binding DatesLine}" TextWrapping="Wrap" Margin="0,3"/></StackPanel>
     </Grid>
    </StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Top"><Button Content="Открыть карточку" Click="Edit_Click"/><Button Content="Истории болезни" Click="History_Click" Style="{StaticResource Quiet}"/></StackPanel>
   </Grid></Border>
  </DataTemplate></ListView.ItemTemplate></ListView><TextBlock x:Name="EmptyText" Text="Пациенты не найдены. Измени условия поиска." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#776B86" Visibility="Collapsed"/></Grid>
  <DockPanel Grid.Row="4" Margin="0,8,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PreviousButton" Content="←" Click="Previous_Click" Style="{StaticResource Quiet}"/><TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="12,0"/><Button x:Name="NextButton" Content="→" Click="Next_Click" Style="{StaticResource Quiet}"/></StackPanel><TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#776B86"/></DockPanel>
 </Grid>
</Page>
