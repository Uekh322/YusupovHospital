<Page Style="{StaticResource {x:Type Page}}" x:Class="YusupovHospital.LoginPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Width="500" Background="White" Padding="32" Margin="20,55" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel>
 <TextBlock Text="Вход в систему" FontSize="28" FontWeight="Bold"/><TextBlock Text="Работа с пациентами и медицинскими записями" Margin="0,10,0,24" TextWrapping="Wrap" Foreground="#776B86"/>
 <TextBlock Text="Логин"/><TextBox x:Name="LoginBox" MaxLength="128"/>
 <TextBlock Text="Пароль"/><PasswordBox x:Name="PasswordBox" Padding="8" Margin="0,4,0,14"/>
 <TextBlock x:Name="ErrorText" Foreground="#AD3347" TextWrapping="Wrap" Margin="0,0,0,12"/>
 <Button x:Name="LoginButton" Content="Войти" Click="Login_Click" IsDefault="True"/>
 </StackPanel></Border></ScrollViewer></Page>
