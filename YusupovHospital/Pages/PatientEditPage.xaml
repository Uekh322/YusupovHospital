<Page Style="{StaticResource {x:Type Page}}" x:Class="YusupovHospital.PatientEditPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,20" MaxWidth="950">
 <DockPanel><Button DockPanel.Dock="Right" Content="← К списку" Click="Cancel_Click" Style="{StaticResource Quiet}"/><TextBlock x:Name="TitleText" Text="Новый пациент" FontSize="28" FontWeight="Bold"/></DockPanel>
 <TextBlock Text="Поля со звёздочкой обязательны для заполнения." Margin="0,10,0,18" Foreground="#776B86"/>
 <Border Background="White" Padding="24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <StackPanel Margin="0,0,24,0"><Image x:Name="PhotoImage" Source="{StaticResource PatientPlaceholder}" Width="170" Height="190" Stretch="UniformToFill"/><Button x:Name="PhotoButton" Content="Выбрать фото" Click="Photo_Click" Style="{StaticResource Quiet}"/><TextBlock Text="PNG или JPEG, до 10 МБ." TextWrapping="Wrap" Foreground="#776B86" FontSize="12" Margin="5,12"/></StackPanel>
 <StackPanel Grid.Column="1"><StackPanel x:Name="Fields">
 <TextBlock Text="Фамилия *"/><TextBox x:Name="LastNameBox" MaxLength="100"/>
 <TextBlock Text="Имя *"/><TextBox x:Name="FirstNameBox" MaxLength="100"/>
 <TextBlock Text="Отчество"/><TextBox x:Name="PatronymicBox" MaxLength="100"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Дата рождения *"/><DatePicker x:Name="BirthPicker"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Пол *"/><ComboBox x:Name="GenderBox"><ComboBoxItem Content="М"/><ComboBoxItem Content="Ж"/></ComboBox></StackPanel></Grid>
 <TextBlock Text="Адрес проживания *"/><TextBox x:Name="AddressBox" MaxLength="357" ToolTip="Например: Уфа, ул. Мира, д. 15, кв. 2"/>

 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
 <StackPanel Margin="0,0,16,0"><TextBlock Text="Телефон *"/><TextBox x:Name="PhoneBox" MaxLength="24" ToolTip="+7 (000) 000-00-00"/></StackPanel>
 <StackPanel Grid.Column="1"><TextBlock Text="Полис ОМС *"/><TextBox x:Name="PolicyBox" MaxLength="19" ToolTip="16 цифр"/></StackPanel></Grid>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
 <StackPanel Margin="0,0,16,0"><TextBlock Text="Паспорт (серия и номер)"/><TextBox x:Name="PassportBox" MaxLength="14" ToolTip="0000 000000"/></StackPanel>
 <StackPanel Grid.Column="1"><TextBlock Text="ИНН"/><TextBox x:Name="InnBox" MaxLength="15" ToolTip="12 цифр"/></StackPanel></Grid>
 <TextBlock Text="СНИЛС"/><TextBox x:Name="SnilsBox" MaxLength="17" ToolTip="000-000-000 00"/>
 </StackPanel><TextBlock x:Name="ErrorText" Foreground="#AD3347" TextWrapping="Wrap" Margin="0,8"/>
 <WrapPanel><Button x:Name="SaveButton" Content="Сохранить" Click="Save_Click"/><Button Content="Отмена" Click="Cancel_Click" Style="{StaticResource Quiet}"/><Button x:Name="DeleteButton" Content="Удалить" Click="Delete_Click" Background="#B8465C"/></WrapPanel>
<Border x:Name="ClinicalPanel" Visibility="Collapsed" Background="#F4F0F9" Padding="14" Margin="0,12,0,0"><StackPanel><TextBlock Text="{Binding CaseHeading}" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" FontWeight="Bold" Margin="0,5"/><TextBlock Text="{Binding HistoriesLine}" TextWrapping="Wrap"/><TextBlock Text="{Binding DiagnosisLine}" TextWrapping="Wrap" Margin="0,4"/><TextBlock Text="{Binding DoctorLine}" TextWrapping="Wrap"/><TextBlock Text="{Binding DepartmentLine}" TextWrapping="Wrap"/><TextBlock Text="{Binding TreatmentLine}" TextWrapping="Wrap"/><TextBlock Text="{Binding DatesLine}" TextWrapping="Wrap" Margin="0,4"/></StackPanel></Border>
 </StackPanel></Grid></Border>
 </StackPanel></ScrollViewer></Page>
