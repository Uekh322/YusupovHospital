<Page Style="{StaticResource {x:Type Page}}" x:Class="YusupovHospital.MedicalPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <DockPanel><Button DockPanel.Dock="Right" Content="← К пациентам" Click="Back_Click" Style="{StaticResource Quiet}"/><TextBlock x:Name="TitleText" FontSize="24" TextWrapping="Wrap"/></DockPanel>
 <TextBlock x:Name="StatusText" Grid.Row="1" Text="Истории болезни • выбери строку для просмотра листов лечения" Margin="0,15" TextWrapping="Wrap"/>
 <DataGrid Grid.Row="2" x:Name="HistoriesGrid" SelectionChanged="History_Changed"><DataGrid.Columns><DataGridTextColumn Header="№" Binding="{Binding Id}"/><DataGridTextColumn Header="Диагноз" Binding="{Binding Diagnosis}" Width="*"/><DataGridTextColumn Header="Врач" Binding="{Binding Doctor}" Width="2*"/><DataGridTextColumn Header="Начало" Binding="{Binding Start, StringFormat=dd.MM.yyyy}"/><DataGridTextColumn Header="Вылечен" Binding="{Binding End, StringFormat=dd.MM.yyyy}"/><DataGridTextColumn Header="Вид лечения" Binding="{Binding Treatment}"/></DataGrid.Columns></DataGrid>
 <TextBlock Grid.Row="3" Text="Листы лечения • просмотр" FontSize="20" Margin="0,20,0,10"/>
 <DataGrid Grid.Row="4" x:Name="TreatmentsGrid"><DataGrid.Columns><DataGridTextColumn Header="Дата" Binding="{Binding Дата_лечения, StringFormat=dd.MM.yyyy}"/><DataGridTextColumn Header="Лекарства" Binding="{Binding Лекарства}" Width="*"/><DataGridTextColumn Header="Температура" Binding="{Binding Температура}"/><DataGridTextColumn Header="Давление" Binding="{Binding Давление}"/><DataGridTextColumn Header="Состояние" Binding="{Binding Состояние}" Width="*"/></DataGrid.Columns></DataGrid>
 </Grid></Page>
