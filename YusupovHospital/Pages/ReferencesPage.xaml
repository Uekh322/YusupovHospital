<Page Style="{StaticResource {x:Type Page}}" x:Class="YusupovHospital.ReferencesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="← К пациентам" Click="Back_Click" Style="{StaticResource Quiet}"/><TextBlock Text="Справочники больницы" FontSize="28" FontWeight="Bold"/></DockPanel><TextBlock Grid.Row="1" x:Name="StatusText" Text="Просмотр врачей и отделений" Margin="0,14" TextWrapping="Wrap"/><TabControl Grid.Row="2"><TabItem Header="Врачи"><DataGrid x:Name="DoctorsGrid"><DataGrid.Columns><DataGridTextColumn Header="Фамилия" Binding="{Binding Фамилия}" Width="*"/><DataGridTextColumn Header="Имя" Binding="{Binding Имя}" Width="*"/><DataGridTextColumn Header="Отчество" Binding="{Binding Отчество}" Width="*"/><DataGridTextColumn Header="Должность" Binding="{Binding Должность}" Width="2*"/><DataGridTextColumn Header="Начало работы" Binding="{Binding Дата_начала_работы, StringFormat=dd.MM.yyyy}"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Отделения"><DataGrid x:Name="DepartmentsGrid"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Название}" Width="*"/><DataGridTextColumn Header="Этаж" Binding="{Binding Этаж}" Width="*"/><DataGridTextColumn Header="Комнаты" Binding="{Binding Номера_комнат}" Width="*"/></DataGrid.Columns></DataGrid></TabItem></TabControl></Grid></Page>
